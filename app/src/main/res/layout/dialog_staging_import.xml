<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/window_background">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/layoutStagingImportTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1976D2"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnCloseStaging"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@android:color/white"
            android:contentDescription="Đóng" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Kiểm duyệt dữ liệu"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:layout_marginStart="12dp"/>

        <TextView
            android:id="@+id/tvStagingTotalCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 mục"
            android:textColor="#E3F2FD"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_pill_blue"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"/>
    </LinearLayout>

    <!-- Bulk Apply Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/surface_card"
        android:elevation="2dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gán hàng loạt cho các dòng đã chọn"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Spinner
                android:id="@+id/spStagingSchool"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="8dp"/>

            <Spinner
                android:id="@+id/spStagingCategory"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="8dp"/>

            <Button
                android:id="@+id/btnApplyBulk"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Áp dụng"
                android:textColor="#1976D2"
                android:textSize="13sp"
                android:textStyle="bold"
                app:strokeColor="#1976D2"
                app:strokeWidth="1dp"
                app:cornerRadius="8dp"
                style="?attr/materialButtonOutlinedStyle"/>
        </LinearLayout>
    </LinearLayout>

    <!-- List Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical"
        android:background="@color/surface_card_secondary"
        android:layout_marginTop="8dp">

        <CheckBox
            android:id="@+id/cbSelectAllStaging"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Light"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chọn tất cả"
            android:textColor="@color/accent_blue"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvStagingEvents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingVertical="8dp"
        android:paddingBottom="80dp"/>

    <!-- Bottom Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_card"
        android:elevation="12dp"
        android:padding="16dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnAddRowStaging"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="+ Thêm dòng"
            android:textColor="#1976D2"
            android:textStyle="bold"
            style="@style/Widget.MaterialComponents.Button.TextButton"/>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnConfirmImportStaging"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Xác nhận nhập (0)"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            android:backgroundTint="#1976D2"/>
    </LinearLayout>
</LinearLayout>