<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề + Nút đóng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="4dp">

            <TextView
                android:id="@+id/tvDrillDownTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CHI TIẾT DANH SÁCH LỊCH"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <ImageButton
                android:id="@+id/btnDrillDownClose"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_tertiary"
                android:contentDescription="Đóng" />
        </LinearLayout>

        <!-- Subtitle + Nút cuộn nhanh -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvDrillDownSub"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Danh sách các buổi phù hợp với tiêu chí đã chọn"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btnDrillDownScrollTop"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="⬆️ Lên đầu"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/btnDrillDownScrollBottom"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="⬇️ Cuối trang"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Danh sách sự kiện -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrillDownEvents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="420dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- Trạng thái trống -->
        <TextView
            android:id="@+id/tvDrillDownEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="28dp"
            android:text="Không có lịch hoặc sự kiện nào trong mục này."
            android:textSize="13sp"
            android:textColor="@color/text_tertiary"
            android:visibility="gone" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

