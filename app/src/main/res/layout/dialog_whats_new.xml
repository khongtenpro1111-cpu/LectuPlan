<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Banner Chào mừng Phiên bản Mới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CẬP NHẬT THÀNH CÔNG!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWhatsNewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phiên bản v1.4.5"
                android:textColor="#E0E7FF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BỘ CẢI TIẾN &amp; TÍNH NĂNG MỚI TRONG v1.4.5:"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Vùng cuộn thông tin tính năng mới -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Tải Phân Trang &amp; Vuốt Chuyển Trang (Swipe Pagination): Phân trang 4 mục/trang kèm chỉ báo Dấu chấm nổi (Page Dots) và vuốt ngang mượt mà trên Trang chủ, Lịch biểu &amp; Báo cáo."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Giao diện Tối giản Ultra-Minimalist: Giấu công cụ lọc/tìm kiếm vào Modal BottomSheet, loại bỏ 100% màu tím và badge AI thừa, tối ưu chuẩn màu Xanh chủ đạo."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Thanh Chuyển Đổi Phân Loại (Segment Switcher): Tối ưu hóa Biểu đồ (Tab 3) và Cài đặt (Tab 5) với thanh chuyển đổi 3-4 nhóm hiển thị 100% trên màn hình không cần cuộn dọc."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Tinh Gọn Bảng Chỉ Số KPI &amp; Danh Sách Tệp: Đưa KPI về 1 hàng 4 cột sắc nét, tối ưu thẻ lịch sử tệp tin và hiển thị phiên bản LectuPlan v1.4.5 xuyên suốt ứng dụng."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhatsNewClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Khám phá &amp; Trải nghiệm ngay"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>