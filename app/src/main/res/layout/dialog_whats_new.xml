<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Banner Chào mừng Phiên bản Mới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎉 CẬP NHẬT THÀNH CÔNG!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWhatsNewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phiên bản v1.1.1"
                android:textColor="#E0E7FF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌟 BỘ CẢI TIẾN &amp; TÍNH NĂNG MỚI TRONG v1.1.1:"
            android:textColor="@color/accent_purple"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Vùng cuộn thông tin tính năng mới -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. 📱 Giao diện Tương thích Tự động (Responsive Design): Tự động co giãn thông minh vừa vặn 100% tất cả các kích thước điện thoại, không che hay mất chữ."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. 🏠 Đổi tên Tab 1 thành 'Trang chủ': Định danh rõ ràng với biểu tượng Ngôi nhà hiện đại, phân biệt rành mạch với Tab Lịch biểu."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. ⚠️ Cảnh báo Trùng giờ khi Lưu lịch: Tự động phát hiện và bật pop-up cảnh báo xung đột thời gian ngay lập tức khi tạo hoặc sửa lịch."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. 📊 Thống kê KPI Cân đối &amp; Sạch sẽ: Làm gọn tên đơn vị trường, hiển thị thông số minh bạch và cân đối chiều cao bộ thẻ thống kê."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="5. ⚡ Nâng cao Hiệu năng &amp; Ổn định: Tối ưu cuộn trang mượt mà, căn chỉnh thanh menu nổi glassmorphism và chuông thông báo."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhatsNewClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🚀 Khám phá &amp; Trải nghiệm ngay"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
