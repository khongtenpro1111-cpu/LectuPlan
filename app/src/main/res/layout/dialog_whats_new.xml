<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Banner Chào mừng Phiên bản Mới -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="@drawable/bg_chip_selected"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CẬP NHẬT THÀNH CÔNG!"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWhatsNewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Phiên bản v1.4.6"
                android:textColor="#E0E7FF"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BỘ CẢI TIẾN &amp; TÍNH NĂNG MỚI TRONG v1.4.6:"
            android:textColor="#2563EB"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <!-- Vùng cuộn thông tin tính năng mới -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. Khắc Phục Hoàn Toàn Lỗi Phân Trang (Page Dots): Xử lý triệt để lỗi đè hai thanh phân trang, đảm bảo chỉ báo trang nổi luôn sắc nét và chính xác theo từng Tab."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2. Trang Giới Thiệu Ứng Dụng Chuyên Biệt: Chuyển toàn bộ thông tin &amp; hướng dẫn vào 1 phân mục Cài đặt riêng trên thanh chuyển đổi Segment Switcher."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="3. Thêm Nút Nổi Dấu Cộng (+): Khởi tạo nhanh công việc/lịch biểu mới mượt mà ngay tại Trang chủ và Lịch biểu."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="4. Tối Ưu Hệ Thống v1.4.6: Tinh gọn giao diện, sửa các lỗi nhỏ và hiển thị nhất quán phiên bản LectuPlan v1.4.6 xuyên suốt ứng dụng."
                    android:textSize="13.5sp"
                    android:textColor="@color/text_primary"
                    android:justificationMode="inter_word"
                    android:layout_marginBottom="10dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnWhatsNewClose"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Khám phá &amp; Trải nghiệm ngay"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2563EB"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:cornerRadius="14dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>