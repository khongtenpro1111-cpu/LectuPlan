<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Tiêu đề hộp thoại -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvFileAnalysisTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔍 XEM NỘI DUNG &amp; PHÂN TÍCH FILE"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tab_header_title" />

            <TextView
                android:id="@+id/btnFileReportScrollTop"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="⬆️ Đầu"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnFileReportScrollBottom"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="⬇️ Cuối"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnCloseAnalysisTop"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/nav_item_unselected_tint" />
        </LinearLayout>

        <!-- Vùng cuộn toàn bộ thông tin + Hình ảnh trang PDF/Ảnh + Văn bản bóc tách đầy đủ không bị che -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsvFileReport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Badge loại file & trạng thái ghi tay / đánh máy -->
                <TextView
                    android:id="@+id/tvFileAnalysisBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_input"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="5dp"
                    android:text="✍️ PHÁT HIỆN TÀI LIỆU CÓ CHỮ GHI TAY"
                    android:textColor="@color/accent_purple"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <!-- Thông tin meta file: Loại file, Tên, Số mục trích xuất -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_input"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvFileAnalysisMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Tên file: ...\n• Định dạng: ..."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>

                <!-- Khung hiển thị trực tiếp các trang PDF hoặc Ảnh chụp (nếu là file PDF / Ảnh) -->
                <LinearLayout
                    android:id="@+id/layoutFileVisualPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📋 TOÀN BỘ NỘI DUNG CHI TIẾT TRONG FILE:"
                    android:textColor="@color/text_primary"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_search_input"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tvFileAnalysisContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textIsSelectable="true"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Hàng nút Tải file về máy + Mở bằng ứng dụng ngoài -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnDownloadFileReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:text="⬇️ Tải file về máy"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOpenExternalReport"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minHeight="44dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="👁️ Mở bằng App khác"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:paddingHorizontal="6dp"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseAnalysisBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="42dp"
            android:layout_marginTop="6dp"
            android:text="✅ Đóng cửa sổ"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/surface_card_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
