<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Tiêu đề Dialog -->
            <TextView
                android:id="@+id/tvDialogHeaderTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📝 THÊM CÔNG VIỆC / SỰ KIỆN"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="@color/tab_header_title" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nhập thông tin lịch biểu công việc giảng dạy"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="16dp" />

            <!-- Ô nhập STT -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STT (Số thứ tự)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtStt"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:hint="Ví dụ: 1, 2, 3..."
                android:inputType="number"
                android:maxLength="5"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:layout_marginBottom="12dp" />

            <!-- Phân loại lịch (Dạy/học, Sự kiện, Phát sinh, Lịch khác) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phân loại lịch *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/spnCategory"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_search_input"
                android:paddingHorizontal="10dp"
                android:layout_marginBottom="12dp" />

            <!-- Ô nhập Tên phân loại tùy chỉnh khi chọn 'Lịch khác (tự đặt tên)' -->
            <LinearLayout
                android:id="@+id/layoutCustomCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tên phân loại lịch khác (Tự đặt tên) *"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="4dp" />

                <EditText
                    android:id="@+id/edtCustomCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="Nhập tên phân loại tự đặt (VD: Nghiên cứu, Việc cá nhân...)"
                    android:inputType="textCapSentences|textMultiLine"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="10dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Ô nhập Tên sự kiện (Tự động xuống dòng khi dài, không cắt chữ) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên sự kiện / Lớp giảng dạy *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:background="@drawable/bg_search_input"
                android:hint="Tên sự kiện / Lớp / Hội đồng / Nội dung chi tiết"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:layout_marginBottom="12dp" />

            <!-- Ô chọn Ngày tổ chức -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngày tổ chức *"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtDate"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:hint="📅 Bấm để chọn ngày tổ chức"
                android:focusable="false"
                android:clickable="true"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:layout_marginBottom="12dp" />

            <!-- Khung Thời gian -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thời gian (Từ - Đến)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <EditText
                    android:id="@+id/edtStartTime"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="Bắt đầu (VD: 07:30)"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingHorizontal="14dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="10dp"
                    android:textColor="@color/text_secondary"/>

                <EditText
                    android:id="@+id/edtEndTime"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input"
                    android:hint="Kết thúc (VD: 11:30)"
                    android:focusable="false"
                    android:clickable="true"
                    android:paddingHorizontal="14dp"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary" />
            </LinearLayout>

            <!-- Ô Địa điểm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa điểm / Phòng học"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtRoom"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:hint="Ví dụ: L2.503, E1-04, Hội trường A..."
                android:inputType="textCapWords"
                android:paddingHorizontal="14dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:layout_marginBottom="12dp" />

            <!-- Ô nhập Người tổ chức (Tự động xuống dòng khi dài, không cắt chữ) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đơn vị / Người tổ chức"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/edtOrganizer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="46dp"
                android:background="@drawable/bg_search_input"
                android:hint="👤 Tên người / Đơn vị giao việc / Ghi chú"
                android:inputType="textCapWords|textMultiLine"
                android:paddingHorizontal="14dp"
                android:paddingVertical="10dp"
                android:textSize="15sp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_tertiary"
                android:layout_marginBottom="20dp" />

            <!-- Hàng nút bấm Hủy & Lưu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCancelDialog"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="Hủy"
                    android:textColor="@color/text_secondary"
                    android:backgroundTint="@color/surface_card_secondary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btnSaveDialog"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1.2"
                    android:layout_marginStart="10dp"
                    android:text="Lưu công việc"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2563EB"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</com.google.android.material.card.MaterialCardView>
