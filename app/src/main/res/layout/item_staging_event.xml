<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStagingEvent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E0E0E0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbStagingItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStagingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sự kiện"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvStagingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2023-10-15"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:drawablePadding="4dp"/>

                <TextView
                    android:id="@+id/tvStagingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:30 - 11:35"
                    android:textSize="14sp"
                    android:textColor="#666666"
                    android:layout_marginStart="12dp"
                    android:drawablePadding="4dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStagingLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HUTECH - E1-04.06"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <TextView
                android:id="@+id/tvStagingWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thiếu thời gian!"
                android:textSize="12sp"
                android:textColor="#D32F2F"
                android:textStyle="italic"
                android:visibility="gone"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="#888888"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>