<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStagingEvent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <CheckBox
            android:id="@+id/cbStagingItem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStagingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tên sự kiện"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:maxLines="3"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvStagingDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2026-11-12"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textStyle="bold"/>

                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@color/border_default"
                    android:layout_marginHorizontal="8dp"/>

                <TextView
                    android:id="@+id/tvStagingTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="07:30 - 11:35"
                    android:textSize="13sp"
                    android:textColor="@color/accent_blue"
                    android:textStyle="bold"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvStagingLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OTHER"
                android:textSize="12sp"
                android:textColor="@color/text_tertiary"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:ellipsize="middle"/>

            <TextView
                android:id="@+id/tvStagingWarning"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚠️ Thiếu thời gian hoặc ngày tháng!"
                android:textSize="12sp"
                android:textColor="@color/accent_red"
                android:textStyle="italic"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/text_secondary"
            android:layout_marginStart="12dp"
            android:contentDescription="Chỉnh sửa"/>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
