<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="2dp"
    android:paddingTop="6dp"
    android:paddingBottom="2dp">

    <!-- Timeline Date Header Badge (Shown once per group date) -->
    <LinearLayout
        android:id="@+id/layoutDateHeaderBadge"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="4dp"
        android:layout_marginBottom="6dp"
        android:layout_marginTop="4dp">

        <View
            android:id="@+id/viewTimelineBranch"
            android:layout_width="4dp"
            android:layout_height="18dp"
            android:background="#2563EB"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tvDateHeaderBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@null"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:text="Thứ Năm, 19/11/2026"
            android:textColor="#0F172A"
            android:textSize="16.5sp"
            android:singleLine="true"
            android:maxLines="1"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- MAIN EVENT CARD ITEM -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEventItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginBottom="8dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_default"
        app:cardBackgroundColor="@color/surface_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Left Vertical Accent Strip (width 4dp) -->
            <View
                android:id="@+id/viewLeftAccentStrip"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="#2563EB"
                android:visibility="visible" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="14dp"
                android:paddingVertical="12dp"
                android:gravity="top">

                <!-- LEFT COLUMN: Period & Time -->
                <LinearLayout
                    android:layout_width="95dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/tvPeriodLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tiết 13-15"
                        android:textColor="#0F172A"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTimeLeft"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="18:00 - 20:30"
                        android:textColor="@color/text_secondary"
                        android:textSize="13.5sp" />
                </LinearLayout>

                <!-- RIGHT COLUMN: Course Title, Room & Class -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title (Max 2 lines, clean ellipsis) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="top">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Thực hành lập trình trên môi trường Windows"
                            android:textColor="#0F172A"
                            android:textSize="16.5sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp" />

                        <CheckBox
                            android:id="@+id/cbSelect"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/btnEdit"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />

                        <ImageButton
                            android:id="@+id/btnDelete"
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Location Row: Phòng: A7 -->
                    <LinearLayout
                        android:id="@+id/layoutRowRoom"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="5dp">

                        <TextView
                            android:id="@+id/tvRoomLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phòng: "
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvRoom"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="A7"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Class/Group Row: Nhóm: 18/Tổ 02 -->
                    <LinearLayout
                        android:id="@+id/layoutRowGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="3dp">

                        <TextView
                            android:id="@+id/tvGroupLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhóm: "
                            android:textColor="@color/text_secondary"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/tvGroup"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="HOCLAI_113"
                            android:textColor="#0F172A"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Compatibility Rows -->
                    <TextView
                        android:id="@+id/tvSemesterBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvTimeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvConflictBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnShareFreeEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutRowTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <TextView android:id="@+id/tvTitleLabel" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutRowPeriod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <TextView android:id="@+id/tvPeriodLabel" android:layout_width="0dp" android:layout_height="0dp" />
                        <TextView android:id="@+id/tvPeriod" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutRowTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <TextView android:id="@+id/tvTimeLabel" android:layout_width="0dp" android:layout_height="0dp" />
                        <TextView android:id="@+id/tvTime" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutRowOrganizer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <TextView android:id="@+id/tvOrganizerLabel" android:layout_width="0dp" android:layout_height="0dp" />
                        <TextView android:id="@+id/tvOrganizer" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutConflictDetails"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="6dp"
                        android:background="#FEF2F2"
                        android:padding="6dp"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/tvConflictDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="#DC2626"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:maxLines="2"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/layoutDateRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:visibility="gone">
                        <TextView android:id="@+id/tvDateLabel" android:layout_width="0dp" android:layout_height="0dp" />
                        <TextView android:id="@+id/tvDate" android:layout_width="0dp" android:layout_height="0dp" />
                    </LinearLayout>

                    <TextView android:id="@+id/tvStt" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
