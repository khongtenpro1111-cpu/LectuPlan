<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1"
    app:cardBackgroundColor="#F8FAFC"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Tầng 1: Icon + Tên file đầy đủ (không cắt chữ) + Nhãn loại file + Thời gian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top">

            <TextView
                android:id="@+id/tvHistoryIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="#DBEAFE"
                android:gravity="center"
                android:text="📂"
                android:textSize="19sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvHistoryFileName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BaoCao_LectuPlan_20261026.xlsx"
                    android:textColor="#0F172A"
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/tvHistoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="#DCFCE7"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="📥 Nhập file • 11 mục"
                    android:textColor="#15803D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHistoryTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="🕒 26/10/2026 16:49"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnDeleteHistory"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Xóa lịch sử"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="#DC2626" />
        </LinearLayout>

        <!-- Tầng 2: Thanh nút hành động (Xem nội dung trực tiếp / Mở bằng app ngoài / Tải file về máy) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/btnViewContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#EDE9FE"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="7dp"
                android:text="📄 Xem nội dung"
                android:textColor="#6D28D9"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnOpenFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.85"
                android:layout_marginStart="6dp"
                android:background="#EFF6FF"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="7dp"
                android:text="👁️ Mở file"
                android:textColor="#2563EB"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnDownloadFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="#DCFCE7"
                android:gravity="center"
                android:paddingHorizontal="6dp"
                android:paddingVertical="7dp"
                android:text="⬇️ Tải về máy"
                android:textColor="#047857"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
