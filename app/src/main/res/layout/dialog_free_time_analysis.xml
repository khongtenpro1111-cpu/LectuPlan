<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="22dp"
    app:cardElevation="8dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header: Tiêu đề & Nút đóng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💡 KHOẢNG THỜI GIAN TRỐNG (7 ngày tới)"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/accent_amber" />

            <ImageButton
                android:id="@+id/btnCloseFreeTimeDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Đóng"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/nav_item_unselected_tint" />
        </LinearLayout>

        <!-- Subheader: Thông tin & Nút cuộn -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Khung giờ chuẩn: Sáng (06:45-11:35) • Chiều (12:30-16:35)"
                android:textSize="11sp"
                android:textColor="@color/text_secondary" />

            <TextView
                android:id="@+id/btnFreeTimeScrollTop"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="⬆️ Đầu"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/btnFreeTimeScrollBottom"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_input"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:text="⬇️ Cuối"
                android:textColor="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFreeTimeDays"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnOpenSmartFinderFromFree"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🔍 Tìm khe nhét"
                android:textColor="#FFFFFF"
                android:backgroundTint="#059669"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnOpenTimelineFromFree"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:minHeight="48dp"
                android:layout_weight="1"
                android:text="⏱️ Dòng chảy\nhôm nay"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnCloseFreeTime"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:text="Đóng"
            android:textColor="@color/text_secondary"
            android:backgroundTint="@color/surface_card_secondary"
            android:textSize="12.5sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
