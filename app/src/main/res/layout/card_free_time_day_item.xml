<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#CBD5E1"
    app:cardBackgroundColor="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Dòng trên: Thứ & Ngày -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFreeDayTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Thứ Hai (26/10/2026)"
                android:textColor="#0F172A"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFreeStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#DCFCE7"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🟢 TRỐNG CẢ NGÀY"
                android:textColor="#15803D"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Dòng dưới: Chi tiết khoảng thời gian trống & lịch bận -->
        <TextView
            android:id="@+id/tvFreeTimeDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="💡 Sáng (07:00 - 11:30): TRỐNG • Chiều (13:00 - 17:00): TRỐNG"
            android:textColor="#334155"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
