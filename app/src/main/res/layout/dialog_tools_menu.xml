<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Thanh kéo mờ phia trên dialog -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#CBD5E1"
        android:layout_marginBottom="16dp" />

    <!-- Header Dialog -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CÔNG CỤ &amp; BỘ LỌC"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseToolsMenu"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary"
            android:contentDescription="Đóng" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Tìm kiếm -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TÌM KIẾM CÔNG VIỆC"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_search_input"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="16dp">

                <EditText
                    android:id="@+id/edtSearchMenu"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Nhập môn học, phòng, ghi chú..."
                    android:textColorHint="@color/text_tertiary"
                    android:textSize="14sp"
                    android:textColor="@color/text_primary"
                    android:singleLine="true"
                    android:imeOptions="actionSearch" />

                <ImageButton
                    android:id="@+id/btnClearSearchMenu"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#94A3B8"
                    android:contentDescription="Xóa tìm kiếm" />
            </LinearLayout>

            <!-- Section 2: Mốc thời gian & Trạng thái -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THỜI GIAN &amp; TRẠNG THÁI"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipTodayMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Hôm nay"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipAllMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Tất cả lịch"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipFreeTimeMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Lịch trống"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipTimelineMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Lịch trùng"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <!-- Section 3: Nhóm công việc -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NHÓM CÔNG VIỆC"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipTeachingMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Dạy / Học"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipMeetingMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Sự kiện / Họp"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipIncidentMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="Lịch phát sinh"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/chipManualMenu"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="Lịch khác"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/surface_card_secondary"
                    app:cornerRadius="10dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="@color/border_default"
                    style="?attr/materialButtonOutlinedStyle" />
            </LinearLayout>

            <!-- Section 4: Chức năng thao tác -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THAO TÁC CƠ BẢN"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenuAddEvent"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Thêm công việc mới"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2563EB"
                app:cornerRadius="10dp"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenuContinuousTimeline"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Xem dòng thời gian liên tục"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/accent_blue"
                android:backgroundTint="@color/surface_card_secondary"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_default"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenuMultiSelect"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="Chế độ chọn nhiều (Sửa / Xóa)"
                android:textSize="13.5sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/surface_card_secondary"
                app:cornerRadius="10dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_default"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMenuResetFilter"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="Xóa tất cả bộ lọc &amp; tìm kiếm"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#DC2626"
                android:backgroundTint="@color/surface_card_secondary"
                app:cornerRadius="10dp"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="#FCA5A5" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
