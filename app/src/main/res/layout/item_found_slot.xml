<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border_default"
    app:cardBackgroundColor="@color/surface_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tvFoundDayTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Thứ Năm, 14/05/2026"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiScoreBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_ai_badge"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="✨ 100đ"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFoundTimeRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="🟢 16:35 - 18:00 (1 giờ 25 phút)"
                android:textColor="#16A34A"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFoundContext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Khả dụng: Đủ thời gian nhận họp/chấm bài"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <Button
                android:id="@+id/btnScheduleSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:text="+ Nhét lịch"
                android:textColor="#FFFFFF"
                android:backgroundTint="#16A34A"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingVertical="4dp"
                app:cornerRadius="8dp" />

            <Button
                android:id="@+id/btnShareSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="36dp"
                android:layout_marginTop="4dp"
                android:text="📢 Báo SV"
                android:textColor="#2563EB"
                android:backgroundTint="#EFF6FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingVertical="4dp"
                app:cornerRadius="8dp"
                style="?attr/materialButtonOutlinedStyle"
                app:strokeColor="#BFDBFE" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
