<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.LectuPlan" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_card_secondary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <!-- Đặt màu chữ/biểu tượng thanh trạng thái và điều hướng thành màu tối khi ở chế độ Sáng -->
        <item name="android:windowLightStatusBar" tools:targetApi="23">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="Theme.LectuPlan" parent="Base.Theme.LectuPlan" />
</resources>
